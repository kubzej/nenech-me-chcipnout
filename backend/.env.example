SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — trusted server-only access, bypasses RLS. Only ever
# used by the cron job scripts (app/jobs/*), never by request-serving routes.
SUPABASE_SERVICE_ROLE_KEY=
APP_ENV=local
APP_CORS_ORIGINS=http://localhost:5173

# Web Push (VAPID) — optional, needed only for push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=
